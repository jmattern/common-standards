{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/common-standards/standards.schema.json",
  "title": "Repository standards configuration",
  "type": "object",
  "required": ["schema_version", "checks", "exceptions"],
  "properties": {
    "schema_version": {"const": 1},
    "checks": {
      "type": "object",
      "required": ["CS-003", "CS-004", "CS-005"],
      "properties": {
        "CS-003": {"$ref": "#/$defs/commandList"},
        "CS-004": {"$ref": "#/$defs/commandList"},
        "CS-005": {"$ref": "#/$defs/commandList"}
      },
      "additionalProperties": false
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "scope", "owner", "justification", "expires"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^CS-[0-9]{3}$"},
          "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "owner": {"type": "string", "minLength": 1},
          "justification": {"type": "string", "minLength": 10},
          "expires": {"type": "string", "format": "date"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "commandList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "argv"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "when": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
