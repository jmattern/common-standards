{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/common-standards/rule.schema.json",
  "title": "Individual coding standard",
  "type": "object",
  "required": ["id", "severity", "title", "definition", "verification"],
  "properties": {
    "id": {"type": "string", "pattern": "^CS-[0-9]{3}$"},
    "severity": {"enum": ["error", "warning"]},
    "title": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 20},
    "verification": {"type": "string", "minLength": 5}
  },
  "additionalProperties": false
}
